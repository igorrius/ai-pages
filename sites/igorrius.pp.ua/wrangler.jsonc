{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "igorrius-pp-ua",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    // Zone routes (the zone already has proxied A/AAAA records for @ and www).
    { "pattern": "igorrius.pp.ua/*", "zone_name": "igorrius.pp.ua" },
    { "pattern": "www.igorrius.pp.ua/*", "zone_name": "igorrius.pp.ua" }
  ],
  "vars": {
    // Public Turnstile site key (secret key goes in `wrangler secret put TURNSTILE_SECRET_KEY`).
    "TURNSTILE_SITE_KEY": "0x4AAAAAAGB4F7FNQQc3VcEo",
    "MAIL_FROM": "site@igorrius.pp.ua",
    "MAIL_TO": "igorrius@gmail.com"
  },
  "send_email": [
    { "name": "SEND_EMAIL", "destination_address": "igorrius@gmail.com" }
  ],
  "observability": { "enabled": true }
}
